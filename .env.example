# Placeholder-only environment template.
# Copy to .env locally and fill in values as needed.
#
# Safety defaults:
# - No production execute_query
# - No silent fallback after explicit provider/backend selection
# - No raw PII in prompts, logs, or generated artifacts

# Semantic inference provider. Keep disabled/mock for offline tests.
SDC_LLM_ENABLED=<0|1>
SDC_LLM_PROVIDER=<mock|local|openai-compatible>
SDC_LLM_ENDPOINT=<SDC_LLM_ENDPOINT>
SDC_LLM_BASE_URL=<SDC_LLM_BASE_URL>
SDC_LLM_MODEL=<SDC_LLM_MODEL>
SDC_LLM_API_KEY=<SDC_LLM_API_KEY>
SDC_LLM_TIMEOUT=<SDC_LLM_TIMEOUT>
SDC_LLM_TEMPERATURE=<SDC_LLM_TEMPERATURE>

# Optional Weaviate retrieval benchmark settings.
SEMANTIC_WEAVIATE_ENABLED=<0|1>
SEMANTIC_WEAVIATE_URL=<SEMANTIC_WEAVIATE_URL>
SEMANTIC_WEAVIATE_COLLECTION=<SEMANTIC_WEAVIATE_COLLECTION>
SEMANTIC_WEAVIATE_API_KEY=<SEMANTIC_WEAVIATE_API_KEY>
SEMANTIC_WEAVIATE_QUERY_MODE=<hybrid|bm25|near_vector>
SEMANTIC_WEAVIATE_QUERY_VECTOR=<SEMANTIC_WEAVIATE_QUERY_VECTOR>

# Optional PostgreSQL fixture scan/profile settings.
SEMANTIC_POSTGRES_ENABLED=<0|1>
SEMANTIC_POSTGRES_DSN=<SEMANTIC_POSTGRES_DSN>
SEMANTIC_POSTGRES_SCHEMA=<SEMANTIC_POSTGRES_SCHEMA>
SEMANTIC_POSTGRES_TABLES=<SEMANTIC_POSTGRES_TABLES>

# Local generated artifact root. This directory is ignored by git.
SEMANTIC_RUNTIME_DIR=<SEMANTIC_RUNTIME_DIR>
